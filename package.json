{
  "name": "jancame",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build crates/tile-efficiency-wasm --target web --out-dir ../../pkg/tile-efficiency-wasm --release",
    "build": "pnpm build:wasm && tsc && vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /JanCame/",
    "test": "pnpm build:wasm && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "4.1.8",
    "happy-dom": "^20.0.10"
  }
}
